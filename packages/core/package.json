{
  "name": "@uni-helper/unh-core",
  "type": "module",
  "version": "0.1.0",
  "description": "Shared core for Unh — context, hooks, SFC cache, file scanning and module system",
  "author": "FliPPeDround <flippedround@qq.com>",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
