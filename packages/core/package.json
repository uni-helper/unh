    "build": "tsdown",
    "dev": "tsdown --watch ./src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": "^4 || ^5 || ^6"
  },
  "dependencies": {
    "@vue/compiler-sfc": "catalog:",
    "ast-kit": "catalog:",
    "chokidar": "catalog:",
