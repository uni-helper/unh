    "magic-string": "catalog:",
    "pathe": "catalog:",
    "scule": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:",
    "vitest": "catalog:testing"
  }
}
