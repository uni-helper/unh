{
  "name": "@uni-helper/unh-layouts",
  "type": "module",
  "version": "0.1.0",
  "description": "Customizable layouts framework for uni-app — Unh layouts module (migrated from vite-plugin-uni-layouts)",
  "author": "FliPPeDround <flippedround@qq.com>",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch ./src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@uni-helper/unh-core": "workspace:*",
    "vite": "^4 || ^5 || ^6"
  },
  "dependencies": {
    "@babel/types": "catalog:",
    "@uni-helper/unh-core": "workspace:*",
    "@uni-helper/uni-env": "catalog:",
    "@vue/compiler-core": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "ast-kit": "catalog:",
    "magic-string": "catalog:",
    "scule": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:",
    "vitest": "catalog:testing"
  }
}
