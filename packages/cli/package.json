{
  "name": "@uni-helper/unh-cli",
  "type": "module",
  "version": "0.1.0",
  "description": "CLI tool for Unh — uni-app development & build commands (migrated from unh root src/cli)",
  "author": "FliPPeDround <flippedround@qq.com>",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./bin": {
      "types": "./dist/bin.d.mts",
      "import": "./dist/bin.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "unh": "dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch ./src",
    "test": "vitest run"
  },
  "dependencies": {
    "cac": "catalog:",
    "consola": "catalog:",
    "cross-spawn": "catalog:",
    "dotenv": "catalog:",
    "dotenv-expand": "catalog:",
    "kolorist": "catalog:",
    "local-pkg": "catalog:",
    "pathe": "catalog:",
    "std-env": "catalog:",
    "strip-ansi": "catalog:",
    "unconfig": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:types",
    "@types/node": "catalog:types",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "vitest": "catalog:testing"
  }
}
