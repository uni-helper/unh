{
  "name": "@uni-helper/unh-monorepo",
  "type": "module",
  "version": "0.3.1",
  "private": true,
  "description": "Unh monorepo — uni-app 开发与构建工具集（Vite 插件 + CLI）",
  "author": "FliPPeDround <flippedround@qq.com>",
  "license": "MIT",
  "funding": "https://afdian.com/a/flippedround",
  "homepage": "https://github.com/uni-helper/unh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/unh.git"
  },
  "bugs": "https://github.com/uni-helper/unh/issues",
  "keywords": [
    "uni",
    "uni-app",
    "uni-helper",
    "cli",
    "miniapp",
    "vite"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release": "bumpp",
    "test": "vitest",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
